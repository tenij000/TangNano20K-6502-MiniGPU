380 A=X+U(D):B=Y+V(D):Z=M(B*32+A):IF (Z=17)|(Z=20) THEN D=4
390 RETURN
420 REM === SPOOK I BEWEGING & AI ===
430 X=G(I):Y=H(I):RECT X,Y,16,16,$E3
440 IF (T>0)&((F&1)=1) THEN GOTO 500
450 IF ((X&15)<>0)|((Y&15)<>0) THEN GOTO 495
460 A=X/16:B=Y/16:E=O(I)
465 IF (A=1)&(B=10)&(E=2) THEN G(I)=336:X=336:GOTO 500
467 IF (A=21)&(B=10)&(E=3) THEN G(I)=16:X=16:GOTO 500
470 IF (A=11)&((B=10)|(B=9)) THEN E=0:GOTO 490
480 K=RND(4):IF (T=0)&((RND(4)+V)>I) THEN GOSUB 520
485 Z=M((B+V(K))*32+A+U(K)):IF (Z<>17)&(Z<>20) THEN E=K:GOTO 490
487 Z=M((B+V(E))*32+A+U(E)):IF (Z=17)|(Z=20) THEN E=RND(4):GOTO 487
490 O(I)=E
495 E=O(I):X=X+U(E)*8:Y=Y+V(E)*8:G(I)=X:H(I)=Y
500 A=16+I:IF T>0 THEN A=20
505 SPRITE A,X,Y
510 IF (ABS(P-X)<12)&(ABS(Q-Y)<12) THEN GOSUB 530
515 RETURN
520 IF ABS(P-X)>ABS(Q-Y) THEN K=2:IF P>X THEN K=3
525 IF ABS(Q-Y)>=ABS(P-X) THEN K=0:IF Q>Y THEN K=1
528 RETURN
530 IF T>0 THEN S=S+200:BEEP 988,6:BEEP 1318,8:G(I)=176:H(I)=160:O(I)=0:GOSUB 740:RETURN
