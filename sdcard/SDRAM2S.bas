10 REM === SDRAM 2-SCHERMEN DEMO (BBC MASTER / MINIGPU-BASIC) ===
20 MODE 1 : TARGET 0 : BIGSPR 0, 0, 0, 0
30 DIM X(16), Y(16), U(16), V(16), C(16), R(16), T(16)
40 FOR I = 0 TO 3
50 X(I) = 100 + I * 130 : Y(I) = 90 + I * 40
60 U(I) = 6 - (I & 1) * 12 : V(I) = 5 - (I & 2) * 5
70 C(I) = RGB(7 - I * 2, I * 2 + 1, 3) : R(I) = 20 + I * 5 : T(I) = I
80 NEXT I
90 P = 1 : F = 0 : W = 0 : J = JOY
95 TARGET 1 : CLS : TARGET 0
100 POKE $4000, 66 : POKE $7000, 77 : POKE $A015, 58 : POKE $B100, 99
110 IF P = 2 THEN GOTO 260
120 REM --- SCHERM 1: BASISVORMEN UIT SDRAM ARRAYS ---
130 CLEAR 1 : RECT 0, 0, 640, 30, $1C
140 GTEXT 24, 10, "SCHERM 1: SDRAM ARRAYS X(I),Y(I),C(I) - BASISVORMEN", $FF
150 FTRI 320, 60, 220, 300, 420, 300, $0B : TRI 320, 60, 220, 300, 420, 300, $3F
160 FOR I = 0 TO 3
170 X(I) = X(I) + U(I) : Y(I) = Y(I) + V(I)
180 IF X(I) < 45 THEN U(I) = ABS(U(I))
190 IF X(I) > 595 THEN U(I) = -ABS(U(I))
200 IF Y(I) < 65 THEN V(I) = ABS(V(I))
210 IF Y(I) > 295 THEN V(I) = -ABS(V(I))
220 IF T(I) = 0 THEN DISK X(I), Y(I), R(I), C(I) : CIRCLE X(I), Y(I), R(I) + 3, $FF
230 IF T(I) = 1 THEN RECT X(I) - R(I), Y(I) - R(I), R(I) * 2, R(I) * 2, C(I)
235 IF T(I) = 2 THEN FTRI X(I), Y(I) - R(I), X(I) - R(I), Y(I) + R(I), X(I) + R(I), Y(I) + R(I), C(I)
238 IF T(I) = 3 THEN CIRCLE X(I), Y(I), R(I), C(I) : DISK X(I), Y(I), 7, $FF
240 NEXT I
250 RECT 0, 336, 640, 24, $08 : GTEXT 110, 344, "SCHERM 1 (VORMEN) -> WISSELT NAAR SCHERM 2", $FC : GOTO 380
260 REM --- SCHERM 2: TEKST & SDRAM GEHEUGEN STATUS ---
270 CLEAR 2 : RECT 0, 0, 640, 30, $80
280 GTEXT 24, 10, "SCHERM 2: TEKST & SDRAM GEHEUGEN STATUS (BBC MASTER)", $FF
290 RECT 24, 48, 592, 110, 0 : RECT 24, 48, 592, 22, $15
300 GTEXT 36, 55, "TANG NANO 20K SDRAM UITBREIDING ACTIEF:", $FC
310 GTEXT 36, 80, "* BASIC PROGRAMMA RAM : $0800 - $9FFF (38.912 BYTES)", $3F
320 GTEXT 36, 102, "* 26 SDRAM ARRAYS A..Z: 26 X 64 KB = 1.66 MB (851K INTS)", $3F
330 GTEXT 36, 124, "* SIDEWAYS RAM VENSTER: $B000 - $DFFF (64 BANKEN = 4 MB)", $3F
340 RECT 24, 174, 592, 140, 0 : RECT 24, 174, 592, 22, $48
350 GTEXT 36, 181, "LIVE KLEUR & STRAAL UIT SDRAM ARRAYS C(0..3) & R(0..3):", $FF
360 FOR I = 0 TO 3 : RECT 44 + I * 140, 215, 110, 76, C(I)
365 DISK 99 + I * 140, 253, R(I), $FF : NEXT I
370 RECT 0, 336, 640, 24, $08 : GTEXT 110, 344, "SCHERM 2 (TEKST) -> WISSELT NAAR SCHERM 1", $FC
380 FLIP : WAIT 1 : F = F + 1 : J = JOY
390 IF F > 18 THEN F = 0 : P = 3 - P : BEEP 660 + P * 220, 2
400 GOTO 110
